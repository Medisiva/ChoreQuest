{
  "name": "chorequest",
  "version": "1.0.0",
  "private": true,
  "description": "ChoreQuest - Family Development & Reward Platform",
  "workspaces": [
    "app",
    "functions"
  ],
  "scripts": {
    "app:start": "cd app && npx expo start",
    "app:android": "cd app && npx expo start --android",
    "app:ios": "cd app && npx expo start --ios",
    "functions:build": "cd functions && npm run build",
    "functions:serve": "cd functions && npm run serve",
    "emulators": "firebase emulators:start --only auth,firestore,functions,storage",
    "dev": "concurrently \"npm run app:start\" \"npm run emulators\"",
    "app:typecheck": "tsc --noEmit -p app/tsconfig.json",
    "test": "node --test app/test/*.test.cjs && npm run test --workspace=chorequest-functions",
    "test:integration": "npm run functions:build && FIREBASE_EMULATORS_PATH=./work/firebase-emulators XDG_CONFIG_HOME=./work/firebase-config firebase emulators:exec --config firebase.test.json --project demo-chorequest --only auth,firestore,functions,storage \"node --test --test-concurrency=1 test/integration/*.test.cjs\""
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "concurrently": "^9.2.4",
    "firebase-tools": "^15.32.1"
  },
  "overrides": {
    "@firebase/firestore": {
      "@grpc/grpc-js": "^1.14.5"
    }
  }
}
