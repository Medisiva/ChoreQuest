rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isFamilyMember(familyId) {
      return request.auth != null &&
        firestore.exists(/databases/(default)/documents/families/$(familyId)/parentUsers/$(request.auth.uid)) &&
        firestore.get(/databases/(default)/documents/families/$(familyId)).data.isDeleted == false;
    }
    // Task proof photos - only family members can read/write
    match /families/{familyId}/taskProofs/{allPaths=**} {
      allow read: if isFamilyMember(familyId);
      allow write: if isFamilyMember(familyId)
        && request.resource.size < 5 * 1024 * 1024  // Max 5MB
        && request.resource.contentType.matches('image/.*');
    }

    // Avatar images
    match /families/{familyId}/avatars/{allPaths=**} {
      allow read: if isFamilyMember(familyId);
      allow write: if isFamilyMember(familyId)
        && request.resource.size < 2 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Default: deny all
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
