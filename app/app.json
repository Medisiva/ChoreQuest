{
  "expo": {
    "name": "ChoreQuest",
    "slug": "chorequest",
    "version": "1.0.3",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "chorequest",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#060609"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.chorequest.app",
      "infoPlist": {
        "NSCameraUsageDescription": "ChoreQuest needs camera access to take photo proof of completed tasks.",
        "NSPhotoLibraryUsageDescription": "ChoreQuest needs photo library access to attach proof of completed tasks."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1A3E6E",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.chorequest.app",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "allowBackup": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-image",
      [
        "expo-camera",
        {
          "cameraPermission": "ChoreQuest needs camera access to take photo proof of completed tasks.",
          "recordAudioAndroid": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "ChoreQuest needs photo library access to attach proof of completed tasks.",
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#1A3E6E"
        }
      ]
    ],
    "owner": "medisivateam",
    "extra": {
      "eas": {
        "projectId": "a130f2f3-ac0b-47e1-97cd-09a324ccdff8"
      }
    }
  }
}
